# Paid third-party asset packs: licensed per seat, must not be redistributed.
# Import them yourself (see README) into these folders.
/Assets/BK/
/Assets/BK.meta
/Assets/Synty/
/Assets/Synty.meta
/Assets/DownloadCache/
/Assets/DownloadCache.meta

# Tools build output and local test credentials
/Tools/**/bin/
/Tools/**/obj/
/Tools/NetTest/local-test-account.txt

# OS
.DS_Store
Thumbs.db

# Textures derived from Synty POLYGON Fantasy Kingdom (not redistributable)
/Assets/UOClient/Materials/SyntyWalls/*.png
/Assets/UOClient/Materials/SyntyWalls/*.png.meta

# Release pipeline: the content key must never be published; the pack asset is temporary
/Assets/UOClient/Scripts/Content/ContentKey.Local.cs
/Assets/UOClient/Scripts/Content/ContentKey.Local.cs.meta
/Assets/UOClient/Generated/
/Assets/UOClient/Generated.meta

# Baked world: derived from UO data, made on each machine by the import (never commit)
/WorldData/

# Server accounts and saves (never commit)
/ServerData/
/WorldSource/

# Secure art (Docs/SecureArt.md): paid packs and icons moved under Assets/Secure, the Addressables setup that
# names their assets (re-made by Tools/SecureArt/SetupSecureArt.eval.cs), and the built (encrypted) bundles.
/Assets/Secure/
/Assets/Secure.meta
/Assets/AddressableAssetsData/
/Assets/AddressableAssetsData.meta
/AddressableContent/

# Art kept out of the open-source repo (images, models, audio under our own folders, including ones our tools
# generate: Tools/Game/MakeSky.eval.cs, Tools/VFX). Their .meta files stay, so references hold once the art is back.
/Assets/UOClient/**/*.png
/Assets/UOClient/**/*.jpg
/Assets/UOClient/**/*.tga
/Assets/UOClient/**/*.psd
/Assets/UOClient/**/*.exr
/Assets/UOClient/**/*.fbx
/Assets/UOClient/**/*.obj
/Assets/UOClient/**/*.blend
/Assets/UOClient/**/*.wav
/Assets/UOClient/**/*.ogg
/Assets/UOClient/**/*.mp3
# FishNet's demo scenes (not used by the game; they bring their own sample art).
/Assets/FishNet/Demos/
/Assets/FishNet/Demos.meta
# Working screenshots (they show the paid art).
/Docs/**/*.png
