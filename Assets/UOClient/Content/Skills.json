 "ValueFormula": "inv = max(0, 100 - Base) / 100; bonus = min((Str*StrScale + Dex*DexScale + Int*IntScale) / 100 * inv, StatTotal * inv); Value = Base + bonus, then skill mods (relative mods that obey the cap only up to Cap).",
 "Defaults": {
  "Cap": 100.0,
  "TotalCap": 700.0,
  "StatCap": {
   "Total": 225,
   "Str": 125,
   "Dex": 125,
   "Int": 125
  },
  "StatMaxCap": {
   "Str": 150,
   "Dex": 150,
   "Int": 150
  },
  "Gains": {
   "EnableAntiMacro": false,
   "EnablePetStatTimeDelay": false,
   "EnablePlayerStatTimeDelay": false,
   "OvercapGains": true,
   "OvercapReach": 50.0,
   "OvercapStart": 100.0,
   "PetChanceToGainStats": 5.0,
   "PetStatTimeDelay": "00:00:05:00",
   "PlayerChanceToGainStats": 10,
   "PlayerSkillGainMultiplier": 2.5,
   "PlayerStatTimeDelay": "00:00:15:00"
  },
  "Notes": "From Config/PlayerCaps.cfg (the shard's values; code defaults are the same caps). Caps are in skill points (the server stores tenths). Times are dd:hh:mm:ss."
 },
 "Uses": {
  "Source": "ServUO Scripts/Skills/*.cs (OnUse / OnTarget), Mobiles/PlayerMobile.cs (OnMove: stealth steps), Misc/RegenRates.cs (armour and meditation), Items/Equipment/Weapons/BaseWeapon.cs (CheckParry). Numbers and rules only; the words are our own.",
  "Notes": "No targeting cursor: skills used on a creature or person take your current target; skills used on an item ask which one (Arms Lore, Item Identification); Detect Hidden searches around you. Formulas use Skill (the skill being used), and the names listed per skill.",
  "Hiding": {
   "Delay": 10,
   "CombatRange": {
    "Expr": "min(trunc((100 - min(100, Skill)) / 2) + 8, 18)",
