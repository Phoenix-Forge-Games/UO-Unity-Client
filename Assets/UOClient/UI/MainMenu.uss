/* The main menu (MainMenu scene): panels on the left over the live town, a loading screen, a black fade. Colours
   follow LoginScreen.uss (placeholder dark-fantasy styling). */

.menu-screen {
    flex-grow: 1;
}

.menu-panel {
    position: absolute;
    left: 64px;
    top: 0;
    bottom: 0;
    width: 420px;
    justify-content: center;
    padding: 28px 32px;
    background-color: rgba(18, 14, 10, 0.82);
    border-left-width: 0;
    border-right-width: 2px;
    border-right-color: rgb(150, 116, 58);
}

.menu-panel .title {
    -unity-text-align: middle-left;
    font-size: 40px;
}

.menu-panel .subtitle {
    -unity-text-align: middle-left;
    margin-bottom: 32px;
}

.menu-item {
    height: 46px;
    margin: 0 0 8px 0;
    padding-left: 16px;
    font-size: 19px;
    -unity-text-align: middle-left;
    color: rgb(236, 224, 200);
    background-color: rgba(58, 46, 34, 0.85);
    border-width: 1px;
    border-color: rgb(120, 94, 52);
    border-radius: 3px;
}

.menu-item:hover {
    background-color: rgb(96, 74, 46);
    color: rgb(255, 238, 200);
}

.menu-item:disabled {
    opacity: 0.4;
}

.menu-toggle Label {
    min-width: 0;
}

.menu-row {
    flex-direction: row;
    justify-content: space-between;
}

.menu-row > Button {
    flex-grow: 1;
    margin-right: 6px;
}

.menu-busy {
    position: absolute;
    left: 96px;
    bottom: 64px;
    font-size: 18px;
    color: rgb(226, 190, 116);
}

/* Characters */
.character-panel {
    width: 520px;
}

.character-panel .primary-button {
    height: 48px;
    font-size: 19px;
}

.choice-selected {
    background-color: rgb(150, 116, 58);
    color: rgb(20, 16, 10);
}

.create-page {
    flex-shrink: 1;
    max-height: 72%;
}

.creator-embedded {
    flex-grow: 1;
    flex-shrink: 1;
}

.creator-side-embedded {
    flex-grow: 1;
    flex-shrink: 1;
}

.creator-embedded .creator-label {
    min-width: 96px;
}

.creator-embedded .creator-style {
    min-width: 140px;
}

.creator-embedded .creator-note {
    margin-left: 96px;
}

/* Options */
.options {
    flex-shrink: 1;
}

.options-tabs {
    flex-direction: row;
    margin-bottom: 8px;
}

.options-tab {
    flex-grow: 1;
    height: 30px;
    margin: 0 4px 0 0;
    color: rgb(214, 200, 176);
    background-color: rgb(48, 40, 32);
    border-color: rgb(100, 80, 50);
}

.options-tab-active {
    background-color: rgb(150, 116, 58);
    color: rgb(20, 16, 10);
}

.options-page {
    max-height: 520px;
    margin-bottom: 8px;
}

.options .setting {
    margin: 4px 0;
}

.options .setting Label {
    min-width: 150px;
    color: rgb(214, 200, 176);
}

.options-key {
    flex-direction: row;
    align-items: center;
    margin: 2px 0;
}

.options-key-name {
    flex-grow: 1;
    color: rgb(214, 200, 176);
}

.options-key-value {
    min-width: 110px;
    color: rgb(236, 226, 206);
}

.options-key-button {
    margin-top: 0;
    height: 24px;
}

.options-note {
    white-space: normal;
    font-size: 12px;
    color: rgb(170, 152, 120);
    margin-top: 6px;
}

/* Loading */
.loading {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgb(10, 8, 6);
}

.loading-title {
    font-size: 54px;
    -unity-font-style: bold;
    color: rgb(226, 190, 116);
    margin-bottom: 8px;
}

.loading-what {
    font-size: 17px;
    color: rgb(190, 176, 150);
    margin-bottom: 28px;
}

.loading-bar {
    width: 560px;
    height: 14px;
    background-color: rgb(32, 26, 20);
    border-width: 1px;
    border-color: rgb(120, 94, 52);
    border-radius: 3px;
}

.loading-fill {
    height: 100%;
    width: 0%;
    background-color: rgb(200, 158, 82);
}

.loading-percent {
    margin-top: 10px;
    font-size: 15px;
    color: rgb(214, 200, 176);
}

/* Fades */
.fade {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgb(0, 0, 0);
    opacity: 0;
}
